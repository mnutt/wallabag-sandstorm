 class Producer implements ProducerInterface
 {
     private $queue;
+    private $requestStack;
 
-    public function __construct(RedisQueue $queue)
+    public function __construct(RedisQueue $queue, \Symfony\Component\HttpFoundation\RequestStack $requestStack)
     {
         $this->queue = $queue;
+        $this->requestStack = $requestStack;
     }
 
     /**
@@ -31,6 +33,19 @@
      */
     public function publish($msgBody, $routingKey = '', $additionalProperties = [])
     {
+        require_once '/opt/app/integration/import-common.php';
+        $request = $this->requestStack->getCurrentRequest();
+        $redis = importRedis();
+        if ($request && !$request->attributes->has('_sandstorm_import_publisher')) {
+            $id = bin2hex(random_bytes(16));
+            $request->attributes->set('_sandstorm_import_publisher', $id);
+            importActivity($request->headers->get('X-Sandstorm-Session-Id', ''));
+        }
+        if ($request) {
+            $redis->zadd('sandstorm.import.publishing', [
+                $request->attributes->get('_sandstorm_import_publisher') => time() + 600,
+            ]);
+        }
         $this->queue->sendJob($msgBody);
     }
 }
