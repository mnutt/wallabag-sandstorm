+    /** Resolve the first document base before extraction removes the head. */
+    private function documentBase($html, $url)
+    {
+        if (stripos($html, '<base') === false) return $url;
+        $previous = libxml_use_internal_errors(true);
+        try {
+            $document = new \DOMDocument();
+            if (!$document->loadHTML($html, LIBXML_NONET | LIBXML_COMPACT)) return $url;
+            $nodes = (new \DOMXPath($document))->query('//base[@href]');
+            if (!$nodes->length) return $url;
+            $base = UriResolver::resolve(new Uri($url), new Uri(trim($nodes->item(0)->getAttribute('href'))));
+            return in_array(strtolower($base->getScheme()), ['http', 'https'], true) ? (string) $base : $url;
+        } catch (\Throwable $e) {
+            return $url;
+        } finally {
+            libxml_clear_errors();
+            libxml_use_internal_errors($previous);
+        }
+    }
