{% set active = counts.queued + counts.processing > 0 %}
{% set state = paused ? 'paused' : (active ? 'active' : (counts.failed ? 'attention' : 'idle')) %}
<section class="card-panel sandstorm-import-notice sandstorm-import-status" data-state="{{ state }}" aria-labelledby="import-status-heading">
    <a class="sandstorm-import-refresh" href="{{ path('import') }}" aria-label="Refresh progress" title="Refresh progress">
        <i class="material-icons" aria-hidden="true">refresh</i>
    </a>
    <h2 id="import-status-heading">{% if paused %}Imports are paused{% elseif active %}Importing{% elseif counts.failed %}Import needs attention{% else %}No imports running{% endif %}</h2>
    <p class="import-status-counts"><span data-import-count="queued"><strong>{{ counts.queued }}</strong> queued</span>, <span data-import-count="processing"><strong>{{ counts.processing }}</strong> in progress</span>, <span data-import-count="failed"><strong>{{ counts.failed }}</strong> need attention</span></p>
    {% if counts.failed %}<p class="import-status-summary">Unsuccessful entries are saved. Retry when you're ready.</p>
    {% elseif active and not paused %}<p class="import-status-summary">Keep this tab open for website approvals.</p>{% endif %}
    <div class="import-status-footer">
        <form method="post" action="{{ path('sandstorm_imports') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('sandstorm_imports') }}">
            {% if paused %}<button class="btn" name="action" value="resume">Resume</button>
            {% else %}<button class="btn" name="action" value="pause">Pause</button>{% endif %}
            {% if counts.failed %}<button class="btn" name="action" value="retry">Retry unsuccessful entries</button>{% endif %}
        </form>
        <span class="import-status-total" title="Since background imports were enabled; includes duplicates and unsuccessful attempts.">{{ processed }} entries processed overall</span>
    </div>
</section>
